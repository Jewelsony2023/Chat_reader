# Google Gemini (server-side only; never exposed to the browser)
GEMINI_API_KEY=
# Optional: override the model (defaults to the latest Gemini Flash set in src/lib/llm/config.ts)
GEMINI_MODEL=
# Optional: 1 = offline mock LLM for development without a key
VIBE_MOCK_LLM=
# Secret that unlocks every report for the app owner: visit /api/creator?key=<this>
CREATOR_KEY=
